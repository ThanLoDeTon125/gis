{
  "name": "@sankit/schema-adapter",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "schema-adapter": "./src/cli.ts"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "node --experimental-strip-types src/cli.ts"
  },
  "devDependencies": {
    "@sankit/config": "workspace:*",
    "@types/node": "^24.13.3",
    "oxlint": "^1.77.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  }
}
